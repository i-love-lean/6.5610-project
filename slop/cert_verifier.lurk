!(load "cert_helpers.lurk")

;; ---------- trace validation ----------
;; Each rule entry is processed in order; later entries may reference earlier
;; ones via E[].  By the topological ordering each lookup `(E j)` for j < i
;; is an already-validated claim.
!(def validate-entry (lambda (i)
  (let ((entry (R i))
        (input (T i)))
    (let ((rule (car entry))
          (output-idx (arg1 entry)))
      (let ((output (T output-idx)))
        (if (= rule 0)               ;; id
          (= output-idx i)
        (if (= rule 1)               ;; congLam
          (let ((b-idx (arg1 input))
                (w0 (arg2 entry)))
            (and (= (E b-idx) w0)
                 (and (= (car output) 1n)
                      (= (arg1 output) w0))))
        (if (= rule 2)               ;; congFn
          (let ((alpha-idx (arg1 input))
                (beta-idx (arg2 input))
                (w0 (arg2 entry))
                (w1 (arg3 entry)))
            (and (= (E alpha-idx) w0)
                 (and (= (E beta-idx) w1)
                      (and (= (car output) 4n)
                           (and (= (arg1 output) w0)
                                (= (arg2 output) w1))))))
        (if (= rule 4)               ;; congProd
          ;; entry = (4 output-idx E[α] E[β] auxFn-idx)
          ;; Output: (5n E[α] E[β]).  T[auxFn] = (4n E[α] (3n 0)).
          (let ((alpha-idx (arg1 input))
                (beta-idx (arg2 input))
                (w0 (arg2 entry))   ;; = E[α]
                (w1 (arg3 entry))   ;; = E[β]
                (w2 (arg4 entry))   ;; = auxFn-idx
                (aux (T (arg4 entry))))
            (and (= (E alpha-idx) w0)
            (and (= (E beta-idx) w1)
            (and (= (car output) 5n)
            (and (= (arg1 output) w0)
            (and (= (arg2 output) w1)
            (and (= (car aux) 4n)
            (and (= (arg1 aux) w0)
                 (let ((u (T (arg2 aux))))
                   (and (= (car u) 3n) (= (arg1 u) 0)))))))))))
        (if (= rule 5)               ;; congSum
          (let ((alpha-idx (arg1 input))
                (beta-idx (arg2 input))
                (w0 (arg2 entry))
                (w1 (arg3 entry)))
            (and (= (E alpha-idx) w0)
                 (and (= (E beta-idx) w1)
                      (and (= (car output) 8n)
                           (and (= (arg1 output) w0)
                                (= (arg2 output) w1))))))
        (if (= rule 6)               ;; congEq
          (let ((a-idx (arg1 input))
                (aprime-idx (arg2 input))
                (alpha-idx (arg3 input))
                (w0 (arg2 entry))
                (w1 (arg3 entry))
                (w2 (arg4 entry)))
            (and (= (E a-idx) w0)
                 (and (= (E aprime-idx) w1)
                      (and (= (E alpha-idx) w2)
                           (and (= (car output) 12n)
                                (and (= (arg1 output) w0)
                                     (and (= (arg2 output) w1)
                                          (= (arg3 output) w2))))))))
        (if (= rule 9)               ;; iota-sum-l
          ;; entry = (9 output f' phi' a' subResPhi subResEvPhi outer)
          ;; f' = 5-deep sum_rec (op 11); a' = 3-deep inl (op 9).
          ;; outer = (2 g γ a) where g = arg3 (arg1 f'); γ = arg1 (arg2 (arg1 f')); a = arg3 a'.
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-outer (arg7 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry)))
                (ap-node (T (arg4 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 5 11n w-fp)
            (and (is-app-k-of 3 9n w-ap)
                 (let ((l1 (T (arg1 fp-node))))
                   (let ((g (arg3 l1))
                         (γ (arg1 (T (arg2 l1))))
                         (a (arg3 ap-node))
                         (outer-node (T w-outer)))
                     (and (= (car outer-node) 2n)
                     (and (= (arg1 outer-node) g)
                     (and (= (arg2 outer-node) γ)
                     (and (= (arg3 outer-node) a)
                          (= (E w-outer) output-idx))))))))))))))))
        (if (= rule 10)              ;; iota-sum-r
          ;; entry = (10 output f' phi' a' subResPhi subResEvPhi outer)
          ;; f' = 5-deep sum_rec; a' = 3-deep inr (op 10).
          ;; outer = (2 g γ b) where g = arg3 f'; γ = arg1 (arg2 f'); b = arg3 a'.
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-outer (arg7 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry)))
                (ap-node (T (arg4 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 5 11n w-fp)
            (and (is-app-k-of 3 10n w-ap)
                 (let ((g (arg3 fp-node))
                       (γ (arg1 (T (arg2 fp-node))))
                       (b (arg3 ap-node))
                       (outer-node (T w-outer)))
                   (and (= (car outer-node) 2n)
                   (and (= (arg1 outer-node) g)
                   (and (= (arg2 outer-node) γ)
                   (and (= (arg3 outer-node) b)
                        (= (E w-outer) output-idx)))))))))))))))
        (if (= rule 8)               ;; iota-prod
          ;; entry = (8 output f' phi' a' subResPhi subResEvPhi subResGamma inner outer)
          ;; f' = 4-deep prod_rec (op 7); a' = 4-deep pmk (op 6).
          ;; phi-of-f' = ((α ⇨ γ) ⇨ _).  Construct expected outer = (2 inner subResGamma b)
          ;;   inner = (2 g (4 α γ) a)
          ;;   subResGamma = sub T[a] T[γ];  b = arg3 T[a'];  a = arg3 (arg1 T[a']).
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-subResGamma (arg7 entry))
                (w-inner (arg8 entry))
                (w-outer (arg9 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry)))
                (ap-node (T (arg4 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 4 7n w-fp)
            (and (is-app-k-of 4 6n w-ap)
                 (let ((phif (T (arg2 fp-node))))
                   (let ((alphaFnGamma (T (arg1 phif))))
                     (let ((α (arg1 alphaFnGamma))
                           (γ (arg2 alphaFnGamma))
                           (g (arg3 fp-node))
                           (aL1 (T (arg1 ap-node))))
                       (let ((a-pk (arg3 aL1))
                             (b-pk (arg3 ap-node))
                             (inner-node (T w-inner))
                             (outer-node (T w-outer)))
                         (and (= (car inner-node) 2n)
                         (and (= (arg1 inner-node) g)
                         (and (= (arg3 inner-node) a-pk)
                              (let ((inner-phi (T (arg2 inner-node))))
                                (and (= (car inner-phi) 4n)
                                (and (= (arg1 inner-phi) α)
                                (and (= (arg2 inner-phi) γ)
                                (and (eq-sub-by 0 a-pk γ w-subResGamma)
                                (and (= (car outer-node) 2n)
                                (and (= (arg1 outer-node) w-inner)
                                (and (= (arg2 outer-node) w-subResGamma)
                                (and (= (arg3 outer-node) b-pk)
                                     (= (E w-outer) output-idx))))))))))))))))))))))))))
        (if (= rule 13)              ;; iota-nat-s
          ;; entry = (13 output f' phi' a' subResPhi subResEvPhi subResGamma inner recApp outer)
          ;; f' = 3-deep nat_rec, a' = 1-deep succ.
          ;; γ = arg2 (arg1 (arg2 T[f']));  g = arg3 T[f'];  n = arg3 T[a'].
          ;; Verify:
          ;;   inner ≡ (2n g (4n nat γ) n)
          ;;   subResGamma ≡ sub T[n] T[γ] (eq-sub-by)
          ;;   recApp ≡ (2n f' phi-idx n)
          ;;   outer ≡ (2n inner subResGamma recApp)
          ;;   output = E[outer]
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-subResGamma (arg7 entry))
                (w-inner (arg8 entry))
                (w-recApp (arg9 entry))
                (w-outer (arg10 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry)))
                (ap-node (T (arg4 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 3 18n w-fp)
            (and (is-app-k-of 1 17n w-ap)
                 (let ((g (arg3 fp-node))
                       (n (arg3 ap-node))
                       (phif (T (arg2 fp-node))))   ;; phif = (4 (4 nat γ) _)
                   (let ((natFnGamma (T (arg1 phif))))   ;; (4 nat γ)
                     (let ((nat-idx (arg1 natFnGamma))
                           (γ (arg2 natFnGamma))
                           (inner-node (T w-inner))
                           (recApp-node (T w-recApp))
                           (outer-node (T w-outer)))
                       (and (= (car (T nat-idx)) 15n)   ;; sanity: nat-idx points to nat
                       ;; inner = (2 g (4 nat γ) n)
                       (and (= (car inner-node) 2n)
                       (and (= (arg1 inner-node) g)
                       (and (= (arg3 inner-node) n)
                            (let ((inner-phi (T (arg2 inner-node))))
                              (and (= (car inner-phi) 4n)
                              (and (= (arg1 inner-phi) nat-idx)
                              (and (= (arg2 inner-phi) γ)
                              ;; subResGamma = sub T[n] T[γ]
                              (and (eq-sub-by 0 n γ w-subResGamma)
                              ;; recApp = (2 f' phi-idx n)
                              (and (= (car recApp-node) 2n)
                              (and (= (arg1 recApp-node) w-fp)
                              (and (= (arg2 recApp-node) phi-idx)
                              (and (= (arg3 recApp-node) n)
                              ;; outer = (2 inner subResGamma recApp)
                              (and (= (car outer-node) 2n)
                              (and (= (arg1 outer-node) w-inner)
                              (and (= (arg2 outer-node) w-subResGamma)
                              (and (= (arg3 outer-node) w-recApp)
                              ;; output = E[outer]
                                   (= (E w-outer) output-idx))))))))))))))))))))))))))))))
        (if (= rule 12)              ;; iota-nat-z
          ;; entry = (12 output f' phi' a' subResPhi subResEvPhi z)
          ;; f' = 3-deep app of nat_rec (op 18); a' = zero (op 16);
          ;; z = arg3 of (arg1 f'); output = E[z].
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-z (arg7 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry)))
                (ap-node (T (arg4 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 3 18n w-fp)
            (and (= (car ap-node) 16n)
            (and (= w-z (arg3 (T (arg1 fp-node))))
                 (= (E w-z) output-idx)))))))))))
        (if (= rule 11)              ;; iota-eq
          ;; entry = (11 output f' phi' a' subResPhi subResEvPhi ha)
          ;; f' must be 5-deep app of eq_rec (op 14), a' must be 2-deep app of refl (op 13).
          ;; Output must equal E[ha].  ha is at arg3 of (arg1 f').
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))
                (w-phip (arg3 entry))
                (w-ap (arg4 entry))
                (w-subResPhi (arg5 entry))
                (w-subResEvPhi (arg6 entry))
                (w-ha (arg7 entry))
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            (and (is-app-k-of 5 14n w-fp)
            (and (is-app-k-of 2 13n w-ap)
            ;; ha = arg3 of (arg1 f')
            (and (= w-ha (arg3 (T (arg1 fp-node))))
                 (= (E w-ha) output-idx)))))))))))
        (if (= rule 7)               ;; beta
          ;; entry = (7 output f' phi' a' subResPhi subResEvPhi bodySubRes)
          ;; Output should equal E[bodySubRes] (= eval of the substituted lambda body).
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w-fp (arg2 entry))      ;; E[f]
                (w-phip (arg3 entry))    ;; E[phi]
                (w-ap (arg4 entry))      ;; E[a]
                (w-subResPhi (arg5 entry))         ;; arg5
                (w-subResEvPhi (arg6 entry))  ;; arg6
                (w-bodySubRes (arg7 entry))  ;; arg7
                (phi-node (T phi-idx))
                (fp-node (T (arg2 entry))))
            (and (= (E f-idx) w-fp)
            (and (= (E phi-idx) w-phip)
            (and (= (E a-idx) w-ap)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w-ap (arg2 phi-node) w-subResPhi)
            (and (= (E w-subResPhi) w-subResEvPhi)
            ;; f' must be a lam — extract its body
            (and (= (car fp-node) 1n)
            ;; bodySubRes structurally equals sub a' (body of f')
            (and (eq-sub-by 0 w-ap (arg1 fp-node) w-bodySubRes)
            ;; output equals E[bodySubRes]
                 (= (E w-bodySubRes) output-idx))))))))))
        (if (= rule 3)               ;; congApp
          ;; entry = (3 output-idx f' phi' a' subRes evalSubRes)
          (let ((f-idx (arg1 input))
                (phi-idx (arg2 input))
                (a-idx (arg3 input))
                (w0 (arg2 entry))   ;; = E[f]
                (w1 (arg3 entry))   ;; = E[phi]
                (w2 (arg4 entry))   ;; = E[a]
                (subRes (arg5 entry))           ;; arg5
                (subResEv (arg6 entry))   ;; arg6
                (phi-node (T phi-idx)))
            (and (= (E f-idx) w0)
            (and (= (E phi-idx) w1)
            (and (= (E a-idx) w2)
            (and (= (car output) 2n)
            (and (= (arg1 output) w0)
            (and (= (arg2 output) w1)
            (and (= (arg3 output) w2)
            (and (= (car phi-node) 4n)
            (and (eq-sub-by 0 w2 (arg2 phi-node) subRes)
                 (= (E subRes) subResEv)))))))))))
          nil))))))))))))))))))) ;; unknown (+iota-sum-l, +iota-sum-r)

!(defrec validate-trace (lambda (i)
  (if (>= i N)
    t
    (if (validate-entry i)
      (validate-trace (+ i 1))
      nil))))

;; ---------- check-cert ----------
;; env: list of TYPE-INDICES of binders enclosing the current term.
;;      Each entry is the *eval'd* index of the binder's domain type.
;; t-idx: index of term to check (well-typed, as embedded in dump).
;; tau-idx: index of expected type.  Caller must ensure tau-idx is the
;; *eval'd* index (so cumeq works structurally).
!(defrec check-cert (lambda (env t-idx tau-idx)
  (let ((t-node (T t-idx))
        (tau-node (T tau-idx))
        (tag (car (T t-idx))))
    (if (= tag 0n)                     ;; var
      (let ((x (arg1 t-node)))
        (if (< x (len env))
          ;; cumeq (incr (x+1) env[x]) tau
          ;; env[x] is already eval'd; we eval tau here too, because the
          ;; app-case recursion `(check-cert env f-idx phi-idx)` passes a
          ;; RAW phi-idx — its un-reduced apps inside would break the
          ;; structural compare in eq-incr-by otherwise.
          (eq-incr-by (+ x 1) 0 (E tau-idx) (geti env x))
          nil))
    (if (= tag 1n)                     ;; lam
      (if (= (car tau-node) 4n)        ;; vs fn
        (let ((b-idx (arg1 t-node))
              (alpha-idx (arg1 tau-node))
              (beta-idx (arg2 tau-node)))
          (check-cert (cons (E alpha-idx) env) b-idx (E beta-idx)))
        nil)
    (if (= tag 2n)                     ;; app
      ;; Look up this app's eval rule entry — both cong-app (rule 3) and beta
      ;; (rule 7) store eval(sub a β) at witness position 6 (= arg6 of entry),
      ;; which is exactly what we want for the cumeq check against tau.
      (let ((f-idx (arg1 t-node))
            (phi-idx (arg2 t-node))
            (a-idx (arg3 t-node))
            (phi-node (T phi-idx))
            (entry (R t-idx)))
        (if (= (car phi-node) 4n)
          (let ((alpha-idx (arg1 phi-node))
                (rule (car entry)))
            (if (or (= rule 3) (or (= rule 7)
                  (or (= rule 8) (or (= rule 9)
                  (or (= rule 10) (or (= rule 11)
                  (or (= rule 12) (= rule 13))))))))
              (let ((subResEv (arg6 entry)))
                (if (check-cert env f-idx phi-idx)
                  (if (check-cert env a-idx (E alpha-idx))
                    (cumeq subResEv tau-idx)
                    nil)
                  nil))
              ;; TODO: iota rules
              nil))
          nil))
    (if (= tag 4n)                     ;; fn
      (if (= (car tau-node) 3n)        ;; vs typ
        (let ((alpha-idx (arg1 t-node))
              (beta-idx (arg2 t-node)))
          (if (check-cert env alpha-idx tau-idx)
            (check-cert (cons (E alpha-idx) env) beta-idx tau-idx)
            nil))
        nil)
    (if (= tag 5n)                     ;; prod
      (if (= (car tau-node) 3n)        ;; vs typ
        ;; Look up the cong-prod rule entry to get the aux-fn-idx (which the
        ;; verifier already validated points to (E[α] ⇨ 𝒰)).
        (let ((alpha-idx (arg1 t-node))
              (beta-idx (arg2 t-node))
              (entry (R t-idx)))
          (if (= (car entry) 4)        ;; cong-prod
            (let ((auxFn (arg4 entry)))
              (if (check-cert env alpha-idx tau-idx)
                (check-cert env beta-idx (E auxFn))
                nil))
            nil))
        nil)
    (if (= tag 8n)                     ;; sum
      (if (= (car tau-node) 3n)        ;; vs typ
        (let ((alpha-idx (arg1 t-node))
              (beta-idx (arg2 t-node)))
          (if (check-cert env alpha-idx tau-idx)
            (check-cert env beta-idx tau-idx)
            nil))
        nil)
    (if (= tag 12n)                    ;; eq
      (if (= (car tau-node) 3n)        ;; vs typ
        (let ((a-idx (arg1 t-node))
              (aprime-idx (arg2 t-node))
              (alpha-idx (arg3 t-node)))
          (if (check-cert env a-idx (E alpha-idx))
            (if (check-cert env aprime-idx (E alpha-idx))
              (check-cert env alpha-idx tau-idx)
              nil)
            nil))
        nil)
    (if (= tag 21n)                    ;; fls
      (if (= (car tau-node) 3n)        ;; ⊥ : 𝒰
        t
        nil)
    (if (= tag 3n)                     ;; typ u  : typ (u+1)
      (if (= (car tau-node) 3n)
        (<= (+ (arg1 t-node) 1) (arg1 tau-node))
        nil)
    (if (= tag 23n)                    ;; opaque ref
      ;; Look up the opaque node's registered type and structurally compare.
      ;; If it isn't in `theorem-alist`, refuse.
      (let ((reg (lookup-theorem t-idx theorem-alist)))
        (if (eq reg nil)
          nil
          (cumeq reg tau-idx)))
      ;; Built-in constant: look up its dbtype and structurally compare to tau.
      ;; If the constant isn't in `dbtype-alist`, we refuse.
      (let ((dbt (lookup-dbtype tag dbtype-alist)))
        (if (eq dbt nil)
          nil
          (cumeq dbt tau-idx))))))))))))))))  ;; (cumeq + if-eq-nil + let + 10 ifs + outer let + lambda + defrec)
